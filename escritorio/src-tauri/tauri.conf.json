{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestion CC Design",
  "mainBinaryName": "Gestion CC Design",
  "version": "1.0.0",
  "identifier": "ar.com.ccdesign.gestion",
  "build": {
    "frontendDist": "../inicio"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CC Design",
    "shortDescription": "Gestión CC Design",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
